# OpenAI-compatible local server. llama.cpp and vLLM both expose this API shape.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=qwen3.5-9b
LLM_PROVIDER=vllm
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=900
LLM_MAX_TOKENS=2048
# Use prompt_json for broad compatibility with llama.cpp and vLLM.
LLM_STRUCTURED_METHOD=prompt_json

# ViZeroLJP retrieval/context budgets.
ALQAC_LAW_CANDIDATES=18
ALQAC_MAX_LAW_EVIDENCE=8
